---
import AboutCode from "./AboutCode.astro";

const contactTranslations = {
  en: {
    title: "CONTACT",
    heading: "Let's connect.",
  },
  de: {
    title: "KONTAKT",
    heading: "Lass uns vernetzen.",
  },
  cn: {
    title: "联系方式",
    heading: "欢迎联系我。",
  },
};

const {
  lang = "en",

  aboutLabel,
  cvLabel,
  projectsLabel,
  researchLabel,
  skillsLabel,

  showResearch = true,
  showSkills = true,

  heroKicker,
  heroTitle,
  heroLine1,
  heroLine2,

  aboutTitle,
  aboutText1,
  aboutText2,
} = Astro.props;

const contactLang =
  lang === "cn" || lang === "zh-CN"
    ? "cn"
    : lang.startsWith("de")
      ? "de"
      : "en";

const contactText = contactTranslations[contactLang];
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <title>Ran Li</title>
  </head>

  <body>

    <header class="nav">
      <div class="nav-logo">RAN.LI</div>
      <nav class="nav-links" aria-label="Main navigation">
        <a href="#about">{aboutLabel}</a>
        <a href="#projects">{projectsLabel}</a>
        <a href="#contact">{contactText.title}</a>

        <details class="language-switcher">
          <summary class="language-trigger">
            {lang === "zh-CN" || lang === "cn" ? "语言" : lang.startsWith("de") ? "SPRACHE" : "LANGUAGE"}
            <span class="language-arrow" aria-hidden="true">▾</span>
          </summary>
          <div class="language-dropdown">
            <a href="/cn/" class:list={{active: lang === "cn" || lang === "zh-CN"}}>中文</a>
            <a href="/de/" class:list={{active: lang.startsWith("de")}}>Deutsch</a>
            <a href="/en/" class:list={{active: lang.startsWith("en")}}>English</a>
          </div>
        </details>
      </nav>
    </header>

    <aside class="side-nav">
      <div class="input-card">
        <span class="input-symbol">INPUT</span>
        <span class="input-name">RAN</span>
        <span class="input-anchor" aria-hidden="true"></span>
      </div>
      <div class="hover-connector" aria-hidden="true"></div>
      <div class="network-line">
        <a class="node node-one" href="#about" aria-label={aboutLabel}>
          <span class="node-index">x1</span>
          <span class="node-label">{aboutLabel}</span>
        </a>
        <a class="node node-two" href="#projects" aria-label={projectsLabel}>
          <span class="node-index">x2</span>
          <span class="node-label">{projectsLabel}</span>
        </a>
        <a class="output-node" href="#contact" aria-label={contactText.title}>
          <span class="output-symbol">ŷ</span>
          <span class="output-label">{contactText.title}</span>
        </a>
      </div>
    </aside>

    <main class="page-content">
      <section class="hero" data-side-theme="blue">
        <div class="hero-copy">
          <p class="kicker">{heroKicker}</p>
          <h1>{heroTitle}</h1>
          <p class="hero-tagline">{heroLine1}<span>{heroLine2}</span></p>
        </div>
      </section>

      <AboutCode lang={lang} />

      <section id="projects" class="placeholder-section theme-blue" data-side-theme="blue">
        <div class="section-inner">
          <p class="section-label">02 / {projectsLabel}</p>
          <h2>{projectsLabel}</h2>
        </div>
      </section>


        <footer id="contact" class="contact-footer">
          <div class="contact-inner">
            <p class="contact-kicker">
              ŷ / {contactText.title}
            </p>

            <h2>{contactText.heading}</h2>

            <div class="contact-links">
              <a href="mailto:your-email@example.com">EMAIL ↗</a>
              <a href="https://github.com/">GITHUB ↗</a>
              <a href="https://linkedin.com/">LINKEDIN ↗</a>
            </div>

            <p class="contact-bottom">
              © {new Date().getFullYear()} RAN LI
            </p>
          </div>
        </footer>
    </main>


    <style>
      /* Three-item navigation: About / Projects / Contact */
      .network-line { height: 100%; }
      .node-one { top: 20%; }
      .node-two { top: 58%; }
      .output-node {
        left: 50%; top: 100%; width: 28px; height: 28px;
        transform: translate(-50%, -50%);
        display: grid; place-items: center;
        border: 3px solid var(--yellow-main); border-radius: 50%;
        background: var(--blue-main); color: var(--yellow-main);
        pointer-events: auto;
      }
      .output-symbol { display: block; width: auto; height: auto; border: 0; background: none; color: inherit; font-size: 16px; line-height: 1; }
      .output-label { position: absolute; left: calc(100% + 14px); top: 50%; transform: translateY(-50%); white-space: nowrap; }
      .output-node:hover, .output-node.active { background: var(--yellow-main); transform: translate(-50%, -50%) scale(1.25); }
      .output-node:hover .output-symbol, .output-node.active .output-symbol { color: var(--black); }

      .language-switcher { position: relative; display: block; margin-left: 12px; padding-left: 18px; border-left: 1px solid rgba(23,23,23,.25); }
      .language-trigger { display: flex; align-items: center; gap: 8px; cursor: pointer; list-style: none; font-size: 13px; font-weight: 700; letter-spacing: .08em; }
      .language-trigger::-webkit-details-marker { display: none; }
      .language-trigger::marker { content: ""; }
      .language-arrow { transition: transform .2s ease; }
      .language-switcher[open] .language-arrow { transform: rotate(180deg); }
      .language-dropdown { position: absolute; right: 0; top: calc(100% + 18px); min-width: 140px; padding: 6px; display: flex; flex-direction: column; background: var(--blue-main); border: 2px solid var(--yellow-main); z-index: 110; box-shadow: 4px 4px 0 rgba(23,23,23,.1); }
      .language-dropdown a { padding: 11px 14px; white-space: nowrap; opacity: 1; }
      .language-dropdown a.active, .language-dropdown a:hover { background: var(--yellow-main); opacity: 1; transform: none; }
      /* Compact contact footer, aligned to the same right-hand content area. */
      .contact-footer {
        min-height: 0;
        padding: 52px clamp(32px, 7vw, 120px) 35px
          calc(var(--rail-width) + var(--content-gap));
        background: var(--blue-main);
        color: var(--black);
        scroll-margin-top: var(--top-nav-height);
      }
      .contact-inner { border-top: 2px solid var(--black); padding-top: 30px; }
      .contact-kicker { margin: 0 0 18px; font-size: 13px; font-weight: 700; letter-spacing: .1em; }
      .contact-inner h2 { margin: 0 0 26px; font-size: clamp(28px, 3.2vw, 44px); }
      .contact-links { display: flex; flex-wrap: wrap; gap: 16px 34px; }
      .contact-links a { color: var(--black); font-size: 14px; font-weight: 700; text-decoration: none; }
      .contact-links a:hover { text-decoration: underline; text-decoration-color: var(--yellow-main); text-decoration-thickness: 3px; text-underline-offset: 5px; }
      .contact-bottom { margin: 46px 0 0; font-size: 11px; opacity: .55; }
      .hero, .placeholder-section, .about-section { background: var(--blue-main); }
      .about-section::before { display: none; }
      @media (max-width:760px) { .contact-footer { padding: 42px 28px 30px; } .language-switcher { padding-left: 10px; margin-left: 4px; } }
    </style>

    <script is:inline>
      const sideNav = document.querySelector(".side-nav");
      const anchor = document.querySelector(".input-anchor");
      const connector = document.querySelector(".hover-connector");
      const nodes = [...document.querySelectorAll(".node")];
      const output = document.querySelector(".output-node");
      const sections = [...document.querySelectorAll("#about, #projects, #contact")];
      let active = null;
      let hovered = null;

      function drawConnector(target) {
        if (!sideNav || !anchor || !connector || !target) return;
        const base = sideNav.getBoundingClientRect();
        const a = anchor.getBoundingClientRect();
        const b = target.getBoundingClientRect();
        const x1 = a.left + a.width / 2 - base.left;
        const y1 = a.top + a.height / 2 - base.top;
        const x2 = b.left + b.width / 2 - base.left;
        const y2 = b.top + b.height / 2 - base.top;
        connector.style.left = `${x1}px`;
        connector.style.top = `${y1}px`;
        connector.style.width = `${Math.hypot(x2 - x1, y2 - y1)}px`;
        connector.style.transform = `rotate(${Math.atan2(y2-y1, x2-x1)}rad)`;
        connector.style.opacity = "1";
      }
      function refreshConnector() {
        if (hovered || active) drawConnector(hovered || active);
        else if (connector) connector.style.opacity = "0";
      }
      function updateActive() {
        // Choose the section at approximately the center of the viewport.
        const center = window.innerHeight * .48;
        const atPageEnd = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
        const section = atPageEnd
          ? document.querySelector("#contact")
          : sections.find(s => {
              const r = s.getBoundingClientRect();
              return r.top <= center && r.bottom > center;
            });
        const target = section
          ? document.querySelector(`.side-nav a[href="#${section.id}"]`)
          : null;
        if (active !== target) {
          nodes.forEach(n => n.classList.remove("active"));
          output?.classList.remove("active");
          active = target;
          active?.classList.add("active");
        }
        refreshConnector();
      }
      [...nodes, output].filter(Boolean).forEach(n => {
        n.addEventListener("mouseenter", () => { hovered = n; refreshConnector(); });
        n.addEventListener("mouseleave", () => { hovered = null; refreshConnector(); });
        n.addEventListener("focus", () => { hovered = n; refreshConnector(); });
        n.addEventListener("blur", () => { hovered = null; refreshConnector(); });
      });
      window.addEventListener("scroll", updateActive, { passive: true });
      window.addEventListener("resize", updateActive);
      updateActive();

      const languageSwitcher = document.querySelector(".language-switcher");
      document.addEventListener("click", e => {
        if (languageSwitcher && !languageSwitcher.contains(e.target)) languageSwitcher.open = false;
      });
      document.addEventListener("keydown", e => {
        if (e.key === "Escape" && languageSwitcher) languageSwitcher.open = false;
      });
    </script>

  </body>
</html>

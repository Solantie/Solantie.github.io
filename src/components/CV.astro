---
/**
 * Multilingual CV section for Astro.
 * Usage: <CV lang={lang} />
 * Edit schoolName placeholders in the `education` array when ready.
 */
const { lang = "en" } = Astro.props;
const locale = lang === "zh-CN" || lang === "cn" || lang.startsWith("zh")
  ? "cn"
  : lang.startsWith("de") ? "de" : "en";

const translations = {
  en: {
    eyebrow: "02 / CURRICULUM VITAE", title: "CV.",
    intro: "Education, professional experience, and academic work.",
    education: "EDUCATION", professional: "WORK EXPERIENCE",
    academic: "RESEARCH & TEACHING", awards: "AWARDS",
    present: "Present", institutionPlaceholder: "[University name — add later]",
    entries: {
      masterCL: ["M.Sc. Computational Linguistics", "Focus: speech processing, NLP, deep learning", "Relevant courses: Deep Learning, Reinforcement Learning, Information Retrieval & Text Mining"],
      masterGerman: ["M.A. German Language and Literature", "Thesis: Metadiscourse in MOOCs — An Analysis of Teacher Discourse in Online German Courses", "Multimodal qualitative analysis of instructional discourse"],
      masterDaF: ["M.A. Deutsch als Fremdsprache (DaF)", "Dual-degree program"],
      bachelor: ["B.A. German Language and Literature", "Minor: English Translation and Interpreting", "Thesis: Frau als Minne-Streberin im Minnesang"],
      fulltime: ["Interpreter & Compliance Specialist", "Microelectronics Corporation · Shanghai", "Monitored semiconductor industry developments and U.S. export-control regulations; prepared Chinese briefings for management.", "Interpreted English–Chinese business negotiations and visits involving international industry representatives.", "Built and maintained bilingual semiconductor and legal terminology resources (1,000+ terms).", "Reviewed and translated commercial and legal contracts; drafted internal compliance materials and delivered training.", "Supported ISO 9001 and ISO/IEC 27001 internal and external audit processes."],
      teaching: ["Lecturer · Introduction to Linguistics", "Affiliated School · Shanghai", "Taught 10 students using cross-linguistic comparisons of Chinese, English, and German."],
      editor: ["Assistant Editor", "University Press · Shanghai", "Coordinated publishing details with authors, proofread manuscripts, and supported planning for an online course."],
      coaching: ["Research Project Support", "[University name — add later] · Marburg", "Recruited seven participants, assessed language proficiency, and provided language coaching."],
      litreview: ["Research Assistant · Metadiscourse", "[University name — add later] · Shanghai", "Reviewed research on metadiscourse and metacommunication in German academic writing and helped categorize discourse strategies."],
      transcription: ["Research Support · Spoken German", "[University name — add later] · Shanghai", "Collected and transcribed oral German assessments and conducted preliminary error analysis."],
    },
    awardsList: [
      ["First Prize · Siyuan Transcreation Award", "10/2021", "Chinese–English marketing translation and layout design"],
      ["Honors Scholarship", "06/2020", ""],
      ["Faculty Scholarship · 8 awards", "2016–2020", ""],
    ],
    note: "Technical course projects are presented separately in Projects."

    },
  de: {
    eyebrow: "02 / LEBENSLAUF", title: "CV.",
    intro: "Ausbildung, Berufserfahrung und wissenschaftliche Tätigkeiten.",
    education: "AUSBILDUNG", professional: "BERUFSERFAHRUNG",
    academic: "FORSCHUNG & LEHRE", awards: "AUSZEICHNUNGEN",
    present: "heute", institutionPlaceholder: "[Universitätsname später ergänzen]",
    entries: {
      masterCL: ["M.Sc. Computational Linguistics", "Schwerpunkte: Sprachverarbeitung, NLP und Deep Learning", "Relevante Lehrveranstaltungen: Deep Learning, Reinforcement Learning, Information Retrieval & Text Mining"],
      masterGerman: ["M.A. German Language and Literature", "Masterarbeit: Metadiskurs in MOOCs – eine Analyse der Lehrendensprache in Online-Deutschkursen", "Multimodale qualitative Analyse von Lehrdiskursen"],
      masterDaF: ["M.A. Deutsch als Fremdsprache (DaF)", "Doppelabschlussprogramm"],
      bachelor: ["B.A. German Language and Literature", "Nebenfach: Englisches Übersetzen und Dolmetschen", "Abschlussarbeit: Frau als Minne-Streberin im Minnesang"],
      fulltime: ["Dolmetscherin & Compliance-Spezialistin", "Mikroelektronikunternehmen · Shanghai", "Beobachtung der Halbleiterbranche und US-Exportkontrollvorschriften; Erstellung chinesischer Briefings für die Geschäftsleitung.", "Englisch-chinesisches Dolmetschen bei internationalen Geschäftsverhandlungen und Unternehmensbesuchen.", "Aufbau und Pflege zweisprachiger Terminologiedatenbanken für Halbleitertechnik und Recht (über 1.000 Einträge).", "Prüfung und Übersetzung von Verträgen; Erstellung von Compliance-Unterlagen und Durchführung von Schulungen.", "Mitwirkung an internen und externen Audits nach ISO 9001 und ISO/IEC 27001."],
      teaching: ["Dozentin · Einführung in die Linguistik", "Angeschlossene Bildungseinrichtung · Shanghai", "Unterricht für zehn Lernende mit Sprachvergleichen zwischen Chinesisch, Englisch und Deutsch."],
      editor: ["Redaktionsassistenz", "Universitätsverlag · Shanghai", "Abstimmung mit Autorinnen und Autoren, Korrekturlesen und Mitplanung eines Onlinekurses."],
      coaching: ["Mitarbeit an einem Forschungsprojekt", "[Universitätsname später ergänzen] · Marburg", "Rekrutierung von sieben Teilnehmenden, Sprachstandserhebung und Sprachlernberatung."],
      litreview: ["Wissenschaftliche Hilfskraft · Metadiskurs", "[Universitätsname später ergänzen] · Shanghai", "Literaturrecherche zu Metadiskurs und Metakommunikation in der deutschen Wissenschaftssprache; Mitwirkung an der Kategorisierung von Strategien."],
      transcription: ["Forschungsmitarbeit · Gesprochenes Deutsch", "[Universitätsname später ergänzen] · Shanghai", "Erhebung und Transkription mündlicher Deutschprüfungen sowie erste Fehleranalysen."],
    },
    awardsList: [
      ["1. Preis · Siyuan Transcreation Award", "10/2021", "Chinesisch-englische Marketingübersetzung und Layoutgestaltung"],
      ["Honors Scholarship", "06/2020", ""],
      ["Fakultätsstipendium · 8 Auszeichnungen", "2016–2020", ""],
    ],
    note: "Technische Studienprojekte werden separat unter Projects vorgestellt."
  },
  cn: {
    eyebrow: "02 / 个人履历", title: "CV.",
    intro: "教育背景、职业经历与科研教学经验。",
    education: "教育背景", professional: "工作经历",
    academic: "科研与教学", awards: "获奖经历",
    present: "至今", institutionPlaceholder: "[学校名称待补充]",
    entries: {
      masterCL: ["计算语言学硕士 · M.Sc.", "研究重点：语音处理、自然语言处理与深度学习", "相关课程：深度学习、强化学习、信息检索与文本挖掘"],
      masterGerman: ["德国语言文学硕士 · M.A.", "硕士论文：MOOC 中的元话语——在线德语课程中的教师话语分析", "采用多模态定性方法分析教学话语"],
      masterDaF: ["对外德语教学硕士 · M.A. DaF", "双学位项目"],
      bachelor: ["德国语言文学学士 · B.A.", "辅修：英语笔译与口译", "毕业论文：中古高地德语爱情诗歌中的女性主动追求者"],
      fulltime: ["口译与合规专员", "微电子企业 · 上海", "跟踪半导体行业动态及美国出口管制法规，为管理层制作中文简报。", "承担国际商务谈判、企业访问等场合的英中口译工作。", "建立并维护半导体与法律双语术语库，累计超过 1,000 条术语。", "审校和翻译中英文商务及法律合同，编写合规手册并开展培训。", "参与 ISO 9001 与 ISO/IEC 27001 内审及外审准备。"],
      teaching: ["讲师 · 语言学导论", "附属教育机构 · 上海", "面向十名学生授课，侧重中、英、德三种语言的对比。"],
      editor: ["编辑助理", "大学出版社 · 上海", "与作者沟通出版事宜、校对文稿，并参与线上课程策划。"],
      coaching: ["科研项目协助", "[学校名称待补充] · 马尔堡", "招募七名参与者，开展语言能力评估与语言学习辅导。"],
      litreview: ["科研助理 · 元话语研究", "[学校名称待补充] · 上海", "梳理德语学术话语中元话语与元交际研究文献，参与话语策略初步分类。"],
      transcription: ["科研协助 · 德语口语语料", "[学校名称待补充] · 上海", "收集并转写德语专业学生口语测试录音，完成初步错误分析。"],
    },
    awardsList: [
      ["思源创译奖 · 一等奖", "10/2021", "企业宣传材料中译英与版式设计"],
      ["荣誉学院奖学金", "06/2020", ""],
      ["院系奖学金 · 共 8 次", "2016–2020", ""],
    ],
    note: "技术课程项目将在 Projects 板块单独展示。"
  }
};

const t = translations[locale];
const e = t.entries;
const education = [
  { date: `10/2025 – ${t.present}`, school: t.institutionPlaceholder, items: e.masterCL },
  { date: "09/2020 – 06/2023", school: t.institutionPlaceholder, items: e.masterGerman },
  { date: "10/2021 – 05/2023", school: t.institutionPlaceholder, items: e.masterDaF },
  { date: "09/2016 – 06/2020", school: t.institutionPlaceholder, items: e.bachelor }
];
const work = [
  { date: "04/2023 – 09/2025", items: e.fulltime },
  { date: "02/2023 – 04/2023", items: e.teaching },
  { date: "07/2019 – 09/2019", items: e.editor }
];
const academic = [
  { date: "10/2021 – 03/2022", items: e.coaching },
  { date: "09/2020 – 06/2021", items: e.litreview },
  { date: "09/2020 – 01/2021", items: e.transcription }
];
---

<section id="cv" class="cv-section" data-side-theme="blue">
  <div class="cv-container">
    <header class="cv-heading">
      <p class="cv-eyebrow">{t.eyebrow}</p>
      <h2>{t.title}</h2>
      <p class="cv-intro">{t.intro}</p>
    </header>

    <div class="cv-group">
      <h3>{t.education}</h3>
      <div class="cv-entries">
        {education.map((entry) => (
          <article class="cv-entry">
            <time class="cv-date">{entry.date}</time>
            <div class="cv-entry-content">
              <h4>{entry.items[0]}</h4>
              <p class="cv-institution cv-placeholder">{entry.school}</p>
              <ul>
                {entry.items.slice(1).map((line) => <li>{line}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="cv-group">
      <h3>{t.professional}</h3>
      <div class="cv-entries">
        {work.map((entry) => (
          <article class="cv-entry">
            <time class="cv-date">{entry.date}</time>
            <div class="cv-entry-content">
              <h4>{entry.items[0]}</h4>
              <p class="cv-institution">{entry.items[1]}</p>
              <ul>
                {entry.items.slice(2).map((line) => <li>{line}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="cv-group">
      <h3>{t.academic}</h3>
      <div class="cv-entries">
        {academic.map((entry) => (
          <article class="cv-entry">
            <time class="cv-date">{entry.date}</time>
            <div class="cv-entry-content">
              <h4>{entry.items[0]}</h4>
              <p class="cv-institution cv-placeholder">{entry.items[1]}</p>
              <ul>
                {entry.items.slice(2).map((line) => <li>{line}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="cv-group">
      <h3>{t.awards}</h3>
      <div class="cv-entries">
        {t.awardsList.map(([name, date, detail]) => (
          <article class="cv-entry cv-award">
            <time class="cv-date">{date}</time>
            <div class="cv-entry-content">
              <h4>{name}</h4>
              {detail && <p class="cv-institution">{detail}</p>}
            </div>
          </article>
        ))}
      </div>
    </div>

    <p class="cv-footnote">{t.note}</p>
  </div>
</section>

<style>
  /* Same background and palette as the rest of the site */
  .cv-section {
    min-height: 100vh;
    padding:
      135px
      clamp(32px, 3.8vw, 64px)
      135px
      calc(var(--rail-width) + var(--content-gap));
    background: var(--blue-main);
    color: var(--black);
  }

  /* Fill the available content area, without the old 920px cap */
  .cv-container {
    width: 100%;
    max-width: none;
    min-width: 0;
  }

  .cv-heading {
    margin-bottom: 68px;
  }

  .cv-eyebrow {
    margin: 0 0 20px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: .1em;
  }

  .cv-heading h2 {
    margin: 0 0 20px;
    font-size: clamp(65px, 7vw, 110px);
    line-height: 1;
    letter-spacing: -.05em;
  }

  .cv-intro {
    margin: 0;
    font-size: clamp(19px, 1.6vw, 23px);
    line-height: 1.55;
  }

  .cv-group {
    margin-bottom: 76px;
  }

  .cv-group h3 {
    margin: 0 0 34px;
    padding-bottom: 15px;
    border-bottom: 2px solid var(--black);
    font-size: clamp(24px, 2.3vw, 32px);
    font-weight: 800;
    letter-spacing: .02em;
  }

  /* Dates occupy a dedicated left column.
     No second vertical timeline or yellow circles. */
  .cv-entries {
    display: flex;
    flex-direction: column;
    gap: 37px;
  }

  .cv-entry {
    display: grid;
    grid-template-columns: clamp(150px, 13vw, 205px) minmax(0, 1fr);
    column-gap: clamp(22px, 2.6vw, 44px);
    align-items: start;
    min-width: 0;
  }

  .cv-date {
    display: block;
    padding-top: 5px;
    color: var(--black);
    font: 700 14px/1.6 "Courier New", monospace;
    letter-spacing: .025em;
    opacity: .72;
    white-space: nowrap;
  }

  .cv-entry-content {
    min-width: 0;
  }

  .cv-entry h4 {
    margin: 0 0 9px;
    font-size: clamp(21px, 1.85vw, 27px);
    font-weight: 700;
    line-height: 1.35;
  }

  .cv-institution {
    margin: 0 0 14px;
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.5;
    font-weight: 700;
    opacity: .82;
  }

  .cv-placeholder {
    font-style: italic;
  }

  .cv-entry ul {
    margin: 0;
    padding-left: 22px;
  }

  .cv-entry li {
    margin: 8px 0;
    font-size: clamp(16px, 1.18vw, 18px);
    line-height: 1.72;
  }

  .cv-entry li::marker {
    color: var(--black);
  }

  .cv-award {
    min-height: 0;
  }

  .cv-footnote {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    opacity: .72;
  }

  @media (max-width: 1100px) {
    .cv-entry {
      grid-template-columns: 145px minmax(0, 1fr);
      column-gap: 22px;
    }
  }

  @media (max-width: 880px) {
    .cv-entry {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 7px;
    }

    .cv-date {
      padding-top: 0;
    }
  }

  @media (max-width: 760px) {
    .cv-section {
      padding: 125px 28px 90px;
    }

    .cv-heading {
      margin-bottom: 50px;
    }

    .cv-group {
      margin-bottom: 52px;
    }

    .cv-group h3 {
      margin-bottom: 26px;
    }

    .cv-entries {
      gap: 30px;
    }

    .cv-entry h4 {
      font-size: 22px;
    }

    .cv-entry li {
      font-size: 16px;
    }
  }
</style>
